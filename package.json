{
    "name": "@vihat-software/mongoose-types",
    "version": "1.0.0",
    "description": "Mongoose Long (int64) and Int32 schema types, maintained fork of mongoose-long and mongoose-int32",
    "license": "MIT AND Apache-2.0",
    "author": "Vihat Software",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Vihat-Software/mongoose-types.git"
    },
    "homepage": "https://github.com/Vihat-Software/mongoose-types#readme",
    "bugs": "https://github.com/Vihat-Software/mongoose-types/issues",
    "keywords": [
        "mongoose",
        "mongodb",
        "long",
        "int64",
        "int32",
        "schematype"
    ],
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "licenses",
        "NOTICE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "packageManager": "yarn@4.18.1",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.json",
        "test": "vitest run",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "prepublishOnly": "yarn build && yarn test"
    },
    "peerDependencies": {
        "mongoose": ">=8 <10"
    },
    "devDependencies": {
        "@types/node": "24",
        "mongodb": "^7.7.0",
        "mongoose": "^9.11.4",
        "prettier": "^3.9.10",
        "prettier-plugin-multiline-arrays": "^4.1.11",
        "typescript": "6.0.3",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    }
}
